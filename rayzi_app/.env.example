# ============================================================================
# PHM Live (rayzi_app) — build-time credentials
# ============================================================================
# Flutter reads these via --dart-define at BUILD time (there is no runtime
# .env loader in the app). This file documents every dart-define so a new
# developer/machine never has to reverse-engineer values out of a compiled
# APK.
#
# HOW TO BUILD WITH REAL VALUES (two supported paths, same secret names):
#
#   1) Local (Windows): set env vars, then run the wrapper:
#        set GOOGLE_WEB_CLIENT_ID=<id>.apps.googleusercontent.com
#        set AGORA_APP_ID=<your-agora-app-id>
#        rayzi_app\build_release.cmd
#
#   2) CI (GitHub Actions): add repo secrets named exactly
#        GOOGLE_WEB_CLIENT_ID   and   AGORA_APP_ID
#      (.github/workflows/flutter.yml already passes them to every build).
#
# NEVER commit the real values anywhere in the repo.
# ============================================================================

# --- Agora -----------------------------------------------------------------
# Where: https://console.agora.io → Projects → Project details → App ID.
# Needed for: live streaming, audio rooms, 1:1 inbox calls, PK battles.
# The backend independently needs AGORA_APP_ID + AGORA_APP_CERTIFICATE
# (Render dashboard); token endpoints return 503 until both are real.
AGORA_APP_ID=

# --- Google Sign-In ----------------------------------------------------------
# Where: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
# Client IDs. Use the "Web application" client id (NOT the Android one).
# One-time setup: also create an Android OAuth client and register this
# app's SHA-1 + package name; then enable the Google provider in
# Supabase Dashboard → Authentication → Providers → Google.
GOOGLE_WEB_CLIENT_ID=

# --- Backend endpoints (optional — defaults below are production) ----------
# Override only when pointing a debug build at a local backend:
#   flutter run --dart-define=API_BASE_URL=http://<lan-ip>:3000/api/v1 \
#               --dart-define=SOCKET_URL=http://<lan-ip>:3000
# API_BASE_URL=https://bigo-like-1.onrender.com/api/v1
# SOCKET_URL=https://bigo-like-1.onrender.com
